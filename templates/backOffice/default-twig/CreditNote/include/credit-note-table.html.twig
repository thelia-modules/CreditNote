{# The credit notes of an order or of a customer, in the data table of the theme: the cells of
   the credit note list (CreditNoteListRowPresenter), without the columns the page already
   states. The order page leaves about half of the screen to the tab: the invoice date sits
   under its number, the total without tax under the total with tax, and the Actions column
   stays in view while the table scrolls. #}
{% set has_order_id = order_id is defined and order_id %}
{% set has_customer_id = customer_id is defined and customer_id %}
{% set grant = { resource: 'admin.order', module: 'creditnote' } %}

{#- A credit note stays editable and deletable until it is numbered; then it can only be
    viewed and printed. View, edit and delete open the modals of the module. -#}
{% set rows = credit_notes|default([])|map(row => row|merge({
    _actions: row.numbered ? [
        row_action('view', 'View'|trans({}, 'creditnote.bo.default-twig'), modalTarget: '#modal-credit-note', dataAttributes: { 'ajax-url': row.view_url, action: 'view' }),
        row_action('invoice', 'PDF'|trans({}, 'creditnote.bo.default-twig'), href: row.pdf_url),
    ] : [
        row_action('edit', 'Edit'|trans({}, 'creditnote.bo.default-twig'), modalTarget: '#modal-credit-note', grantedAttribute: 'UPDATE', grantedSubject: grant, dataAttributes: { 'ajax-url': row.view_url, action: 'view' }),
        row_action('delete', 'Delete'|trans({}, 'creditnote.bo.default-twig'), modalTarget: '#modal-credit-note-delete', grantedAttribute: 'DELETE', grantedSubject: grant, dataAttributes: { 'ajax-url': row.delete_url, action: 'delete' }),
    ],
})) %}

{% set columns = [
    column_html('ref_html', 'Reference'|trans({}, 'creditnote.bo.default-twig')),
    column_html('invoice_html', 'Inv. ref'|trans({}, 'creditnote.bo.default-twig')),
] %}
{% if not has_order_id %}
    {% set columns = columns|merge([column_html('order_html', 'Order'|trans({}, 'creditnote.bo.default-twig'))]) %}
{% endif %}
{% set columns = columns|merge([
    column_badge('status_id', 'Status'|trans({}, 'creditnote.bo.default-twig'), {}, 'start', 'status', 'status_color'),
    column_badge('type_id', 'Type'|trans({}, 'creditnote.bo.default-twig'), {}, 'start', 'type', 'type_color'),
    column_html('amount_html', 'Total'|trans({}, 'creditnote.bo.default-twig'), 'end'),
    column_actions('_actions', 'Actions'|trans({}, 'creditnote.bo.default-twig')),
]) %}

{% component 'BoDataTable' with {
    id: has_order_id ? 'order-credit-notes' : 'customer-credit-notes',
    caption: 'Credit notes'|trans({}, 'creditnote.bo.default-twig'),
    columns: columns,
    rows: rows,
    emptyMessage: 'You have no credit notes for the moment.'|trans({}, 'creditnote.bo.default-twig'),
    rowIdentifierKey: 'label',
} %}
    {% block toolbar %}
        {% if is_granted('UPDATE', grant) %}
            <button type="button"
                    class="btn btn-primary btn-sm"
                    data-bs-toggle="modal"
                    data-bs-target="#modal-credit-note"
                    data-customer-id="{{ has_customer_id ? customer_id : '' }}"
                    data-order-id="{{ has_order_id ? order_id : '' }}"
                    data-ajax-url="{{ path('credit_note_ajax_create') }}"
                    data-action="create"
                    data-testid="credit-note-add">
                <i class="bi bi-plus-lg" aria-hidden="true"></i> {{ 'Add a new credit note'|trans({}, 'creditnote.bo.default-twig') }}
            </button>
        {% endif %}
    {% endblock %}
{% endcomponent %}
