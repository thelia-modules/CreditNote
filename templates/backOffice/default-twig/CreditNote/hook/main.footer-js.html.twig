{# main.footer-js hook — injects a "Credit Notes" section right below the "Orders" one of the admin side menu
   (_side_nav.html.twig of default-twig, which has no hook between sections), with the markup of its sections.
   Data: menu_statuses, total_count. #}
{% if is_granted('VIEW', 'admin.order') %}
  {% set active = admin_current_location == 'credit-note' %}
  <template id="credit_note_menu-template">
    <li class="nav-item" id="credit_note_menu" data-testid="bo-nav-credit-note">
      <a href="#collapse-credit-notes" data-bs-toggle="collapse" aria-expanded="{{ active ? 'true' : 'false' }}" class="nav-link bo-side-nav__toggle {{ active ? 'active' : '' }}">
        <i class="bi bi-receipt me-2" aria-hidden="true"></i>
        {{ 'Credit Notes'|trans({}, 'creditnote.bo.default') }}
        <i class="bi bi-chevron-right ms-auto bo-side-nav__chevron" aria-hidden="true"></i>
      </a>
      <ul class="nav flex-column collapse {{ active ? 'show' : '' }}" id="collapse-credit-notes">
        <li>
          <a class="nav-link" href="{{ path('credit_note_list') }}">
            {{ 'All Credit Notes'|trans({}, 'creditnote.bo.default') }}
            <span class="bo-side-nav__badge bo-side-nav__badge--neutral">{{ total_count }}</span>
          </a>
        </li>
        {% for status in menu_statuses %}
          <li>
            <a class="nav-link" href="{{ path('credit_note_list', {status_id: status.id}) }}">
              {{ status.title }}
              <span class="bo-side-nav__badge" style="background-color: {{ status.color }}; color: #fff;">{{ status.count }}</span>
            </a>
          </li>
        {% endfor %}
      </ul>
    </li>
  </template>

  <script type="text/javascript">
    "use strict";
    (function () {
      var tpl = document.getElementById('credit_note_menu-template');
      var ordersMenu = document.querySelector('[data-testid="bo-nav-order"]');
      if (!tpl || !ordersMenu || document.getElementById('credit_note_menu')) {
        return;
      }
      ordersMenu.parentNode.insertBefore(tpl.content.cloneNode(true), ordersMenu.nextSibling);
    })();
  </script>
{% endif %}
