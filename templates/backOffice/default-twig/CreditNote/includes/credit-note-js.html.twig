{# Credit-note modal driver — dependency-free vanilla JS (no jQuery/select2/CDN under the Twig BO). #}
<script type="text/javascript">
"use strict";
(function () {
  /* ---- delete modal: copy the trigger's ajax-url into the form action ---- */
  var delModal = document.getElementById('modal-credit-note-delete');
  if (delModal) {
    delModal.addEventListener('show.bs.modal', function (event) {
      var url = event.relatedTarget && event.relatedTarget.dataset.ajaxUrl;
      var form = delModal.querySelector('form');
      if (url && form) form.setAttribute('action', url);
    });
  }

  /* ---- main create/edit modal ---- */
  var modal = document.getElementById('modal-credit-note');
  if (!modal) return;

  var modalBody = modal.querySelector('.modal-body');
  var modalLoader = modal.querySelector('.modal-loader');
  var modalError = modal.querySelector('.modal-error');
  var currentController = null;
  var lastAjaxUrl;
  var refreshTimer = null;

  function loaderOn() { modalLoader.classList.remove('d-none'); modalBody.classList.add('d-none'); }
  function loaderOff() { modalLoader.classList.add('d-none'); modalBody.classList.remove('d-none'); }
  function hideError() {
    modalError.classList.add('d-none');
    var iframe = modalError.querySelector('iframe');
    if (iframe) iframe.srcdoc = '';
  }
  function displayError(status, text) {
    loaderOff();
    modalBody.classList.add('d-none');
    modalError.classList.remove('d-none');
    var st = modalError.querySelector('.textStatus');
    if (st) st.textContent = status;
    var iframe = modalError.querySelector('iframe');
    if (iframe) iframe.srcdoc = text || '';
  }
  function reset() { hideError(); loaderOn(); }

  function getFormData(overrides) {
    var form = modalBody.querySelector('form');
    var params = new URLSearchParams();
    if (form) {
      new FormData(form).forEach(function (v, k) { params.append(k, v); });
    }
    Object.keys(overrides || {}).forEach(function (k) {
      params.delete(k);
      params.append(k, overrides[k]);
    });
    return params;
  }

  function loadAjax(trigger, params) {
    if (currentController) currentController.abort();
    var url = trigger && trigger.dataset ? trigger.dataset.ajaxUrl : undefined;
    if (!url) { url = lastAjaxUrl; } else { lastAjaxUrl = url; loaderOn(); }
    if (!url) return;
    params = params || new URLSearchParams();
    if (trigger && trigger.dataset) {
      var d = trigger.dataset;
      if (d.successUrl) params.set('success-url', d.successUrl);
      if (d.creditNoteId) params.set('credit_note_create[credit_note_id]', d.creditNoteId);
      if (d.orderId) params.set('credit_note_create[order_id]', d.orderId);
      if (d.orderProductId) params.set('credit_note_create[order_product_quantity][' + d.orderProductId + ']', '1');
      if (d.typeId) params.set('credit_note_create[type_id]', d.typeId);
      if (d.customerId) params.set('credit_note_create[customer_id]', d.customerId);
    }
    if (!params.get('credit_note_create[action]')) params.set('credit_note_create[action]', 'view');

    currentController = new AbortController();
    fetch(url, { method: 'POST', body: params, signal: currentController.signal, headers: { 'X-Requested-With': 'XMLHttpRequest' } })
      .then(function (resp) {
        return resp.text().then(function (text) {
          if (!resp.ok) { displayError(resp.status + ' ' + resp.statusText, text); return; }
          loaderOff();
          modalBody.innerHTML = text;
          modalReady();
        });
      })
      .catch(function (err) { if (err.name !== 'AbortError') displayError('network error', String(err)); });
  }

  modal.addEventListener('show.bs.modal', function (event) { loadAjax(event.relatedTarget); });
  modal.addEventListener('hidden.bs.modal', function () { reset(); lastAjaxUrl = undefined; });

  function refreshNow() { loadAjax(null, getFormData({ 'credit_note_create[action]': 'refresh' })); }
  function refreshWithTimer() {
    if (refreshTimer !== null) clearTimeout(refreshTimer);
    refreshTimer = setTimeout(refreshNow, 700);
  }

  /* ---- ajax-searchable select (vanilla replacement for the select2 ajax mode) ----
     The native <select> stays as the form-value holder (hidden); a text input queries
     data-url (?q=...&customerId=...) and the picked item becomes a selected <option>. */
  function upgradeAjaxSelect(select) {
    if (!select || select.dataset.cnUpgraded) return;
    select.dataset.cnUpgraded = '1';
    var wrap = document.createElement('div');
    wrap.className = 'position-relative';
    select.parentNode.insertBefore(wrap, select);
    wrap.appendChild(select);
    select.classList.add('d-none');

    var input = document.createElement('input');
    input.type = 'text';
    input.className = 'form-control';
    input.autocomplete = 'off';
    input.placeholder = select.dataset.placeholder || '';
    if (select.selectedOptions.length && select.value) {
      input.value = select.selectedOptions[0].textContent.trim();
    }
    wrap.appendChild(input);

    var list = document.createElement('div');
    list.className = 'list-group position-absolute w-100 d-none shadow';
    list.style.zIndex = '1070';
    list.style.maxHeight = '260px';
    list.style.overflowY = 'auto';
    wrap.appendChild(list);

    var searchController = null;
    var searchTimer = null;

    function closeList() { list.classList.add('d-none'); list.innerHTML = ''; }

    input.addEventListener('input', function () {
      var q = input.value.trim();
      if (searchTimer) clearTimeout(searchTimer);
      if (q.length < 3) { closeList(); return; }
      searchTimer = setTimeout(function () {
        if (searchController) searchController.abort();
        searchController = new AbortController();
        var u = new URL(select.dataset.url, window.location.origin);
        u.searchParams.set('q', q);
        if (select.dataset.customerId) u.searchParams.set('customerId', select.dataset.customerId);
        fetch(u, { signal: searchController.signal, headers: { 'X-Requested-With': 'XMLHttpRequest' } })
          .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
          .then(function (data) {
            list.innerHTML = '';
            var items = (data && data.items) || [];
            if (!items.length) {
              var empty = document.createElement('div');
              empty.className = 'list-group-item disabled small';
              empty.textContent = '{{ 'No results found'|trans({}, 'creditnote.bo.default')|escape('js') }}';
              list.appendChild(empty);
            }
            items.forEach(function (item) {
              var btn = document.createElement('button');
              btn.type = 'button';
              btn.className = 'list-group-item list-group-item-action';
              var label = item.ref + ' : (' + item.firstname + ' ' + item.lastname + ')';
              var line = document.createElement('div');
              line.textContent = label;
              btn.appendChild(line);
              if (item.address) {
                var small = document.createElement('small');
                small.className = 'text-body-secondary';
                small.textContent = item.address;
                btn.appendChild(small);
              }
              btn.addEventListener('click', function () {
                var opt = null;
                for (var i = 0; i < select.options.length; i++) {
                  if (select.options[i].value === String(item.id)) { opt = select.options[i]; break; }
                }
                if (!opt) {
                  opt = document.createElement('option');
                  opt.value = item.id;
                  opt.textContent = label;
                  select.appendChild(opt);
                }
                select.value = String(item.id);
                input.value = label;
                closeList();
                onPicked(select);
              });
              list.appendChild(btn);
            });
            list.classList.remove('d-none');
          })
          .catch(function (err) { if (err.name !== 'AbortError') closeList(); });
      }, 250);
    });

    document.addEventListener('click', function (e) { if (!wrap.contains(e.target)) closeList(); });
  }

  function onPicked(select) {
    var overrides = { 'credit_note_create[action]': 'refresh' };
    if (select.classList.contains('js-select-order')) overrides['credit_note_create[order_id]'] = select.value;
    if (select.classList.contains('js-select-customer')) overrides['credit_note_create[customer_id]'] = select.value;
    loadAjax(null, getFormData(overrides));
  }

  function toggleNoFreeAmount(table) {
    var hasRows = false;
    table.querySelectorAll('tbody tr').forEach(function (r) {
      if (!r.classList.contains('js-no-free-amount')) hasRows = true;
    });
    var noRow = table.querySelector('.js-no-free-amount');
    if (noRow) noRow.classList.toggle('d-none', hasRows);
  }

  var freeAmountController = null;
  function recomputeFreeAmount(field) {
    var row = field.closest('tr');
    if (!row || !field.dataset.url) return;
    if (freeAmountController) freeAmountController.abort();
    freeAmountController = new AbortController();
    var u = new URL(field.dataset.url, window.location.origin);
    u.searchParams.set('price', String(parseFloat(field.value) || 0));
    var taxRule = row.querySelector('.js-field-tax-rule');
    u.searchParams.set('tax_rule_id', String(taxRule ? parseInt(taxRule.value, 10) || 0 : 0));
    fetch(u, { signal: freeAmountController.signal, headers: { 'X-Requested-With': 'XMLHttpRequest' } })
      .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
      .then(function (data) {
        var twin = field.classList.contains('js-field-amount-without-tax')
          ? row.querySelector('.js-field-amount-with-tax')
          : row.querySelector('.js-field-amount-without-tax');
        if (twin) twin.value = data.result;
        refreshWithTimer();
      })
      .catch(function (err) { if (err.name !== 'AbortError') displayError('price calculation error', String(err)); });
  }

  function modalReady() {
    var form = modalBody.querySelector('form');
    if (!form) return;

    var selCustomer = form.querySelector('.js-select-customer');
    if (selCustomer && !selCustomer.disabled) upgradeAjaxSelect(selCustomer);
    var selOrder = form.querySelector('.js-select-order');
    if (selOrder && !selOrder.dataset.customerId && !selOrder.disabled) upgradeAjaxSelect(selOrder);

    ['.js-select-type', '.js-select-status', '.js-select-invoice-address'].forEach(function (s) {
      var el = form.querySelector(s);
      if (el) el.addEventListener('change', function () { onPicked(el); });
    });
    if (selOrder && selOrder.dataset.customerId) {
      selOrder.addEventListener('change', function () { onPicked(selOrder); });
    }

    form.addEventListener('change', function (e) {
      var t = e.target;
      if (t.closest('.js-field-currency') || t.closest('.js-order-product-quantity')) { refreshNow(); return; }
      if (t.closest('.js-field-tax-rule')) {
        var row = t.closest('tr');
        var without = row && row.querySelector('.js-field-amount-without-tax');
        if (without) recomputeFreeAmount(without);
        return;
      }
      if (t.matches('.js-action-refresh') && t.value.length) refreshWithTimer();
    });
    form.addEventListener('keyup', function (e) {
      var t = e.target;
      if (t.matches('.js-action-refresh') && t.value.length) { refreshWithTimer(); return; }
      if (t.matches('.js-field-amount-without-tax') || t.matches('.js-field-amount-with-tax')) recomputeFreeAmount(t);
    });

    var table = form.querySelector('.js-table-free-amount');
    if (table) {
      table.addEventListener('click', function (e) {
        var add = e.target.closest('.js-action-add');
        if (add) {
          e.preventDefault();
          var tpl = modalBody.querySelector('#template-credit-note-free-amount');
          if (!tpl) return;
          add.dataset.key = String(parseInt(add.dataset.key || '0', 10) + 1);
          var html = tpl.innerHTML.replace(/\[\]/g, '[' + add.dataset.key + ']');
          var tmp = document.createElement('tbody');
          tmp.innerHTML = html;
          var tbody = table.querySelector('tbody');
          while (tmp.firstElementChild) tbody.appendChild(tmp.firstElementChild);
          toggleNoFreeAmount(table);
          return;
        }
        var del = e.target.closest('.js-action-delete');
        if (del) {
          e.preventDefault();
          var tr = del.closest('tr');
          if (tr) tr.remove();
          toggleNoFreeAmount(table);
          refreshNow();
        }
      });
    }
  }
})();
</script>

<script type="text/javascript">
  document.addEventListener('DOMContentLoaded', function () {
    var clearBtn = document.getElementById('clear-selection');
    if (clearBtn) {
      clearBtn.addEventListener('click', function (ev) {
        ev.preventDefault();
        document.querySelectorAll('input').forEach(function (el) { el.value = ''; });
        document.querySelectorAll('select').forEach(function (el) { el.value = 'all'; });
      });
    }
  });
</script>
