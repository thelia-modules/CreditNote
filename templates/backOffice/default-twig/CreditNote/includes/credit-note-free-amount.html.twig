{# One free-amount detail row. Fields use the CollectionType prefixed naming
   `credit_note_create[<field>][<key>]` so validateForm() binds them. Vars: fa (nullable), key, invoiced, tax_rules. #}
{% set fa = fa|default(null) %}
<tr>
  <td>
    <select class="form-select" name="credit_note_create[free_amount_type][{{ key }}]" {{ invoiced ? 'disabled' : '' }}>
      <option value="other" {{ fa and fa.type == 'other' ? 'selected' : '' }}>{{ 'Other'|trans({}, 'creditnote.bo.default') }}</option>
      <option value="shipping" {{ fa and fa.type == 'shipping' ? 'selected' : '' }}>{{ 'Shipping'|trans({}, 'creditnote.bo.default') }}</option>
      <option value="fees" {{ fa and fa.type == 'fees' ? 'selected' : '' }}>{{ 'Fees'|trans({}, 'creditnote.bo.default') }}</option>
    </select>
  </td>
  <td>
    <input type="text" name="credit_note_create[free_amount_title][{{ key }}]" class="form-control"
           value="{{ fa ? fa.title : '' }}" placeholder="{{ 'Title'|trans({}, 'creditnote.bo.default') }}" {{ invoiced ? 'disabled' : '' }}>
  </td>
  <td>
    <input type="number" step="0.000001" name="credit_note_create[free_amount_price][{{ key }}]"
           class="form-control js-field-amount-without-tax" value="{{ fa ? fa.price : '' }}"
           placeholder="{{ 'Amount without tax'|trans({}, 'creditnote.bo.default') }}"
           data-url="/admin/product/calculate-raw-price?action=to_tax" {{ invoiced ? 'disabled' : '' }}>
  </td>
  <td>
    <select class="form-select js-field-tax-rule" name="credit_note_create[free_amount_tax_rule_id][{{ key }}]" {{ invoiced ? 'disabled' : '' }}>
      {% for taxRule in tax_rules %}
        <option value="{{ taxRule.id }}" {{ fa and fa.tax_rule_id == taxRule.id ? 'selected' : '' }}>{{ taxRule.title }}</option>
      {% endfor %}
    </select>
  </td>
  <td>
    <input type="number" step="0.000001" name="credit_note_create[free_amount_price_with_tax][{{ key }}]"
           class="form-control js-field-amount-with-tax" value="{{ fa ? fa.price_with_tax : '' }}"
           placeholder="{{ 'Amount with tax'|trans({}, 'creditnote.bo.default') }}"
           data-url="/admin/product/calculate-raw-price?action=from_tax" {{ invoiced ? 'disabled' : '' }}>
  </td>
  <td class="action">
    <input type="hidden" name="credit_note_create[free_amount_id][{{ key }}]" value="{{ fa ? fa.id : '' }}">
    {% if not invoiced %}
      <button type="button" class="btn btn-danger btn-sm js-action-delete" title="{{ 'Delete'|trans({}, 'creditnote.bo.default') }}">
        <i class="bi bi-trash"></i>
      </button>
    {% endif %}
  </td>
</tr>
