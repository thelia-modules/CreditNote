{# Credit-note list page, laid out like the order list of default-twig (search, collapsed advanced
   filters, active filter chips, BoDataTable, BoPagination). Rendered by CreditNoteController::listAction;
   rows by CreditNoteListRowPresenter, filters by CreditNoteListFilterPresenter. #}
{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Credit notes'|trans({}, 'creditnote.bo.default-twig') }}{% endblock %}
{% block body_testid %}credit-notes-list{% endblock %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb" class="mb-1">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="{{ path('admin.home') }}">{{ 'Home'|trans }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ 'Credit notes'|trans({}, 'creditnote.bo.default-twig') }}</li>
        </ol>
    </nav>
{% endblock %}

{% block content %}
    {{ safe_hook('credit-notes.top') }}

    <div class="container-fluid" id="module-credit-note" data-testid="credit-notes-page">
        {% embed '@BackOfficeDefaultTwig/_page_header.html.twig' with { title: 'Credit notes management'|trans({}, 'creditnote.bo.default-twig') } %}
            {% block actions %}
                <button type="button" class="btn btn-sm btn-primary"
                        data-bs-toggle="modal" data-bs-target="#modal-credit-note"
                        data-ajax-url="{{ path('credit_note_ajax_create') }}"
                        data-action="create"
                        data-testid="credit-note-create">
                    <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>{{ 'Add a new credit note'|trans({}, 'creditnote.bo.default-twig') }}
                </button>
            {% endblock %}
        {% endembed %}

        <form method="get" action="{{ path('credit_note_list') }}" class="bo-order-filters" data-testid="credit-note-search-form">
            <div class="row g-2 align-items-end">
                <div class="col-md-9">
                    <label class="form-label" for="credit-note-search-q">{{ 'Search'|trans({}, 'creditnote.bo.default-twig') }}</label>
                    <input type="search" id="credit-note-search-q" name="q" value="{{ filters.search_input }}"
                           class="form-control"
                           placeholder="{{ 'Reference, number, order, customer name or email'|trans({}, 'creditnote.bo.default-twig') }}"
                           data-testid="credit-note-search-input">
                </div>
                <div class="col-md-3 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1" data-testid="credit-note-search-submit">
                        <i class="bi bi-funnel me-1" aria-hidden="true"></i>{{ 'Apply'|trans({}, 'creditnote.bo.default-twig') }}
                    </button>
                    <a href="{{ filters.clear_all_url }}" class="btn btn-outline-secondary" data-testid="credit-note-reset">{{ 'Reset'|trans({}, 'creditnote.bo.default-twig') }}</a>
                </div>
            </div>

            <div class="mt-3">
                <button type="button" class="btn btn-link p-0 bo-order-filters__toggle" data-bs-toggle="collapse"
                        data-bs-target="#bo-credit-note-advanced" aria-controls="bo-credit-note-advanced"
                        aria-expanded="false"
                        data-testid="credit-note-advanced-toggle">
                    <i class="bi bi-sliders me-1" aria-hidden="true"></i>
                    <span class="bo-order-filters__toggle-label">{{ 'Advanced filters'|trans({}, 'creditnote.bo.default-twig') }}</span>
                    {% if filters.advanced_count > 0 %}
                        <span class="badge bg-primary ms-1">{{ filters.advanced_count }}</span>
                    {% endif %}
                    <i class="bi bi-chevron-down ms-1 bo-order-filters__toggle-caret" aria-hidden="true"></i>
                </button>
            </div>

            <div id="bo-credit-note-advanced" class="bo-order-filters__panel collapse" data-testid="credit-note-advanced-panel">
                <div class="row g-2 pt-2">
                    <div class="col-md-6 col-lg-4">
                        <fieldset>
                            <legend class="form-label">{{ 'Status'|trans({}, 'creditnote.bo.default-twig') }}</legend>
                            <div class="d-flex flex-wrap gap-2">
                                {% for option in filters.status_options %}
                                    {% set checked = option.id in filters.selected_status_ids %}
                                    <label class="bo-order-filters__pill" data-checked="{{ checked ? 'true' : 'false' }}"
                                           style="--pill-color: {{ option.color }};">
                                        <input type="checkbox" class="visually-hidden" name="status_ids[]"
                                               value="{{ option.id }}" {{ checked ? 'checked' : '' }}
                                               data-testid="credit-note-filter-status-{{ option.id }}">
                                        <span class="bo-order-filters__pill-dot" aria-hidden="true"></span>
                                        {{ option.title }}
                                    </label>
                                {% endfor %}
                            </div>
                        </fieldset>
                    </div>

                    <div class="col-md-6 col-lg-4">
                        <fieldset>
                            <legend class="form-label">{{ 'Type'|trans({}, 'creditnote.bo.default-twig') }}</legend>
                            <div class="d-flex flex-wrap gap-2">
                                {% for option in filters.type_options %}
                                    {% set checked = option.id in filters.selected_type_ids %}
                                    <label class="bo-order-filters__pill" data-checked="{{ checked ? 'true' : 'false' }}"
                                           style="--pill-color: {{ option.color }};">
                                        <input type="checkbox" class="visually-hidden" name="type_ids[]"
                                               value="{{ option.id }}" {{ checked ? 'checked' : '' }}
                                               data-testid="credit-note-filter-type-{{ option.id }}">
                                        <span class="bo-order-filters__pill-dot" aria-hidden="true"></span>
                                        {{ option.title }}
                                    </label>
                                {% endfor %}
                            </div>
                        </fieldset>
                    </div>

                    <div class="col-md-6 col-lg-4">
                        <fieldset>
                            <legend class="form-label">{{ 'Invoice date between'|trans({}, 'creditnote.bo.default-twig') }}</legend>
                            <div class="row g-2">
                                <div class="col">
                                    <input type="date" name="invoice_date_from" value="{{ filters.invoice_date_from_input }}"
                                           class="form-control form-control-sm" aria-label="{{ 'From'|trans({}, 'creditnote.bo.default-twig') }}"
                                           data-testid="credit-note-filter-invoice-date-from">
                                </div>
                                <div class="col">
                                    <input type="date" name="invoice_date_to" value="{{ filters.invoice_date_to_input }}"
                                           class="form-control form-control-sm" aria-label="{{ 'To'|trans({}, 'creditnote.bo.default-twig') }}"
                                           data-testid="credit-note-filter-invoice-date-to">
                                </div>
                            </div>
                        </fieldset>
                    </div>

                    <div class="col-md-6 col-lg-4">
                        <fieldset>
                            <legend class="form-label">{{ 'Total amount (TTC)'|trans({}, 'creditnote.bo.default-twig') }}</legend>
                            <div class="bo-range-slider" data-controller="bo-range-slider"
                                 data-bo-range-slider-min-value="{{ filters.amount_slider.min }}"
                                 data-bo-range-slider-max-value="{{ filters.amount_slider.max }}"
                                 data-bo-range-slider-step-value="{{ filters.amount_slider.step }}">
                                <div class="bo-range-slider__rail">
                                    <div class="bo-range-slider__track">
                                        <div class="bo-range-slider__fill" data-bo-range-slider-target="fill"></div>
                                    </div>
                                    <input type="range" class="bo-range-slider__handle"
                                           data-bo-range-slider-target="minRange"
                                           data-action="input->bo-range-slider#onMinRange"
                                           min="{{ filters.amount_slider.min }}" max="{{ filters.amount_slider.max }}"
                                           step="{{ filters.amount_slider.step }}"
                                           value="{{ filters.amount_slider.min }}"
                                           aria-label="{{ 'Min'|trans({}, 'creditnote.bo.default-twig') }}">
                                    <input type="range" class="bo-range-slider__handle"
                                           data-bo-range-slider-target="maxRange"
                                           data-action="input->bo-range-slider#onMaxRange"
                                           min="{{ filters.amount_slider.min }}" max="{{ filters.amount_slider.max }}"
                                           step="{{ filters.amount_slider.step }}"
                                           value="{{ filters.amount_slider.max }}"
                                           aria-label="{{ 'Max'|trans({}, 'creditnote.bo.default-twig') }}">
                                </div>
                                <div class="row g-1 mt-1">
                                    <div class="col">
                                        <div class="input-group input-group-sm">
                                            <input type="text" name="min_amount" value="{{ filters.min_amount_input }}"
                                                   class="form-control" placeholder="{{ 'Min'|trans({}, 'creditnote.bo.default-twig') }}" inputmode="decimal"
                                                   aria-label="{{ 'Min'|trans({}, 'creditnote.bo.default-twig') }}"
                                                   data-bo-range-slider-target="minInput"
                                                   data-action="change->bo-range-slider#onMinInput"
                                                   data-testid="credit-note-filter-min-amount">
                                            <span class="input-group-text">{{ filters.amount_slider.currency }}</span>
                                        </div>
                                    </div>
                                    <div class="col">
                                        <div class="input-group input-group-sm">
                                            <input type="text" name="max_amount" value="{{ filters.max_amount_input }}"
                                                   class="form-control" placeholder="{{ 'Max'|trans({}, 'creditnote.bo.default-twig') }}" inputmode="decimal"
                                                   aria-label="{{ 'Max'|trans({}, 'creditnote.bo.default-twig') }}"
                                                   data-bo-range-slider-target="maxInput"
                                                   data-action="change->bo-range-slider#onMaxInput"
                                                   data-testid="credit-note-filter-max-amount">
                                            <span class="input-group-text">{{ filters.amount_slider.currency }}</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </fieldset>
                    </div>
                </div>
            </div>

            <input type="hidden" name="order" value="{{ filters.sort_field }}">
            <input type="hidden" name="direction" value="{{ filters.sort_direction }}">
        </form>

        {% if filters.active_chips %}
            <div class="bo-order-filters__active-chips d-flex align-items-center gap-2 mt-3" data-testid="credit-note-active-chips">
                <span class="text-muted small flex-shrink-0">{{ 'Active filters:'|trans({}, 'creditnote.bo.default-twig') }}</span>
                <div class="d-flex flex-nowrap align-items-center gap-2 overflow-x-auto" role="region" tabindex="0" aria-label="{{ 'Active filters:'|trans({}, 'creditnote.bo.default-twig') }}">
                    {% for chip in filters.active_chips %}
                        <a class="bo-order-filters__chip d-inline-flex align-items-center gap-1 text-decoration-none flex-shrink-0"
                           href="{{ chip.remove_url }}"
                           data-testid="credit-note-active-chip-{{ chip.key }}"
                           title="{{ 'Remove this filter'|trans({}, 'creditnote.bo.default-twig') }}">
                            <span class="bo-order-filters__chip-label">{{ chip.label }}:</span>
                            <strong class="bo-order-filters__chip-value">{{ chip.value }}</strong>
                            <i class="bi bi-x-lg" aria-hidden="true"></i>
                        </a>
                    {% endfor %}
                </div>
                <a class="bo-order-filters__clear-all small text-decoration-none ms-1 flex-shrink-0"
                   href="{{ filters.clear_all_url }}"
                   data-testid="credit-note-clear-all">
                    <i class="bi bi-eraser me-1" aria-hidden="true"></i>{{ 'Clear all'|trans({}, 'creditnote.bo.default-twig') }}
                </a>
            </div>
        {% endif %}

        <div class="mt-3">
            {#- A credit note stays editable and deletable until it is numbered; then it can only be
                viewed and printed. View, edit and delete open the modals of the module. -#}
            {% set grant = { resource: 'admin.module', module: 'creditnote' } %}
            {% set rows = rows|map(row => row|merge({
                _actions: row.numbered ? [
                    row_action('view', 'View'|trans({}, 'creditnote.bo.default-twig'), modalTarget: '#modal-credit-note', dataAttributes: { 'ajax-url': row.view_url, action: 'view' }),
                    row_action('invoice', 'PDF'|trans({}, 'creditnote.bo.default-twig'), href: row.pdf_url),
                ] : [
                    row_action('edit', 'Edit'|trans({}, 'creditnote.bo.default-twig'), modalTarget: '#modal-credit-note', grantedAttribute: 'UPDATE', grantedSubject: grant, dataAttributes: { 'ajax-url': row.view_url, action: 'view' }),
                    row_action('delete', 'Delete'|trans({}, 'creditnote.bo.default-twig'), modalTarget: '#modal-credit-note-delete', grantedAttribute: 'DELETE', grantedSubject: grant, dataAttributes: { 'ajax-url': row.delete_url, action: 'delete' }),
                ],
            })) %}

            {{ component('BoDataTable', {
                id: 'credit-notes',
                columns: [
                    column_html('ref_html', 'Reference'|trans({}, 'creditnote.bo.default-twig'), 'start', 'ref'),
                    column_html('invoice_html', 'Inv. ref'|trans({}, 'creditnote.bo.default-twig'), visibleFrom: 'md'),
                    column_html('customer_html', 'Customer'|trans({}, 'creditnote.bo.default-twig'), visibleFrom: 'lg'),
                    column_html('order_html', 'Order'|trans({}, 'creditnote.bo.default-twig'), visibleFrom: 'md'),
                    column_badge('status_id', 'Status'|trans({}, 'creditnote.bo.default-twig'), {}, 'start', 'status', 'status_color'),
                    column_badge('type_id', 'Type'|trans({}, 'creditnote.bo.default-twig'), {}, 'start', 'type', 'type_color', visibleFrom: 'xl'),
                    column_html('amount_html', 'Total'|trans({}, 'creditnote.bo.default-twig'), 'end', 'total'),
                    column_html('created_html', 'Create date'|trans({}, 'creditnote.bo.default-twig'), 'start', 'created_at', visibleFrom: 'lg'),
                    column_html('updated_html', 'Update date'|trans({}, 'creditnote.bo.default-twig'), 'start', 'updated_at', visibleFrom: 'xl'),
                    column_actions('_actions', 'Actions'|trans({}, 'creditnote.bo.default-twig')),
                ],
                rows: rows,
                emptyMessage: 'No credit note matches the current filters.'|trans({}, 'creditnote.bo.default-twig'),
                sortField: filters.sort_field,
                sortDirection: filters.sort_direction,
                sortParam: 'order',
                sortDirectionParam: 'direction',
                sortKeepParams: query_params,
                rowIdentifierKey: 'label',
            }) }}

            {{ component('BoPagination', {
                route: 'credit_note_list',
                currentPage: current_page,
                lastPage: pages,
                routeParams: query_params,
                ariaLabel: 'Credit note pagination'|trans({}, 'creditnote.bo.default-twig'),
                testid: 'credit-note-pagination',
            }) }}
        </div>

        {{ safe_hook('credit-notes.bottom') }}

        {% include '@CreditNoteModule/backOffice/default-twig/CreditNote/includes/credit-note-modal.html.twig' %}
    </div>
{% endblock %}

{% block scripts_extra %}
    {{ parent() }}
    {% include '@CreditNoteModule/backOffice/default-twig/CreditNote/includes/credit-note-js.html.twig' %}
    {{ safe_hook('credit-notes.js') }}
{% endblock %}
