{# The credit notes of the buyer on the payment step, drawn in the line of the module in the
   "Pay part of your order with" block (hook checkout.payment.parts). One box per credit note
   with something left; ticking one puts it on the cart. The amount applied and what is left to
   pay are shown by the theme, from the composition of the payment. Texts are translated by the
   module. Variables: this.choices [{id, ref, balance, reserved, whole_only}], this.texts,
   this.error. #}
<div {{ attributes }} data-loading="addClass(opacity-50 pointer-events-none)" data-testid="checkout-credit-notes">
    {% set choices = this.choices %}
    {% set texts = this.texts %}
    {% if choices|length %}
        <fieldset>
            <legend class="sr-only">{{ texts.legend }}</legend>
            <ul class="flex flex-col gap-2 mt-3">
                {% for choice in choices %}
                    <li data-credit-note-ref="{{ choice.ref }}">
                        {{ component('Fields:Checkbox:Base', {
                            label: texts.credit_note ~ ' ' ~ choice.ref ~ ' — ' ~ choice.balance ~ ' ' ~ texts.left,
                            'input:id': 'checkout-credit-note-' ~ choice.id,
                            'input:name': 'checkout-credit-note-' ~ choice.id,
                            'input:checked': choice.reserved,
                            'input:data-action': 'change->live#action',
                            'input:data-live-action-param': 'toggle',
                            'input:data-live-credit-note-id-param': choice.id,
                        }|merge(choice.whole_only ? {'input:aria-describedby': 'checkout-credit-note-note-' ~ choice.id} : {})) }}
                        {% if choice.whole_only %}
                            <p id="checkout-credit-note-note-{{ choice.id }}" class="paragraph-4 text-grey-dark mt-1">{{ texts.whole_only }}</p>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        </fieldset>
    {% endif %}
    {% if this.error %}
        <twig:Molecules:SnackBar:Base variant="warning" withIcon role="alert" class="mt-3" text="{{ this.error|escape('html') }}" />
    {% endif %}
</div>
